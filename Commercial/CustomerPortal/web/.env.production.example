# THE GOLD MIND PROFESSIONAL — Production Environment Template
# Copy to Vercel Project Settings → Environment Variables (Production).
# Do NOT commit real secrets.

# --- Core auth (required) ---
AUTH_SECRET=
AUTH_URL=https://YOUR_PRODUCTION_DOMAIN
NEXTAUTH_URL=https://YOUR_PRODUCTION_DOMAIN
NEXTAUTH_SECRET=

# --- Durable license store (required on Vercel) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LICENSE_STORE_SECRET=

# --- Admin elevation (required; no local defaults in production) ---
PORTAL_SUPER_ADMIN_EMAILS=owner@yourdomain.com
PORTAL_ADMIN_EMAILS=
PORTAL_COMMERCIAL_MANAGER_EMAILS=
PORTAL_FINANCE_EMAILS=
PORTAL_SUPPORT_EMAILS=
PORTAL_QA_EMAILS=
PORTAL_AUDITOR_EMAILS=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com

# --- Payments (Paddle live) ---
PADDLE_VENDOR_ID=
PADDLE_PRICE_ID=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# PAYMENT_FORCE_SANDBOX must remain unset/false in production

# --- Google OAuth (optional but recommended) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET also accepted as aliases

# --- Public site ---
NEXT_PUBLIC_APP_URL=https://YOUR_PRODUCTION_DOMAIN

# --- Release packaging (optional overrides) ---
# RELEASE_STABLE_ZIP_URL=
