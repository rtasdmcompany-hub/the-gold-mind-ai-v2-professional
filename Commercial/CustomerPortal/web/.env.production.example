# THE GOLD MIND PROFESSIONAL — Production Environment
# Generated: 2026-07-31
# STATUS: TEMPLATE READY — no live secrets were present in the repository or runtime.
# Copy values into Vercel Production env, or fill locally (this file is gitignored).
#
# Brand: all customer-facing identity is centralized in src/lib/brand.ts.
# Set NEXT_PUBLIC_BRAND_* / BRAND_* below to override defaults without code changes.

NODE_ENV=production

# --- Core auth (REQUIRED) ---
AUTH_SECRET=
NEXTAUTH_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
AUTH_URL=https://YOUR_PRODUCTION_DOMAIN
NEXTAUTH_URL=https://YOUR_PRODUCTION_DOMAIN
NEXT_PUBLIC_APP_URL=https://YOUR_PRODUCTION_DOMAIN

# --- Brand identity (optional overrides — defaults in src/lib/brand.ts) ---
NEXT_PUBLIC_BRAND_NAME=THE GOLD MIND
NEXT_PUBLIC_BRAND_COMPANY=THE GOLD MIND
NEXT_PUBLIC_BRAND_PRODUCT=THE GOLD MIND PROFESSIONAL
NEXT_PUBLIC_BRAND_PRODUCT_FULL=THE GOLD MIND AI v2.0 PROFESSIONAL
NEXT_PUBLIC_BRAND_VERSION=1.0.0
NEXT_PUBLIC_BRAND_TAGLINE=Automated Trading Software
NEXT_PUBLIC_BRAND_DOMAIN=thegoldmind.ai
NEXT_PUBLIC_BRAND_WEBSITE=https://YOUR_PRODUCTION_DOMAIN
NEXT_PUBLIC_BRAND_SUPPORT_EMAIL=support@thegoldmind.ai
NEXT_PUBLIC_BRAND_BILLING_EMAIL=billing@thegoldmind.ai
NEXT_PUBLIC_BRAND_LICENSE_EMAIL=license@thegoldmind.ai
NEXT_PUBLIC_BRAND_ADMIN_EMAIL=admin@thegoldmind.ai
NEXT_PUBLIC_BRAND_NOREPLY_EMAIL=noreply@thegoldmind.ai
# Optional social (leave blank until live)
NEXT_PUBLIC_BRAND_SOCIAL_X=
NEXT_PUBLIC_BRAND_SOCIAL_LINKEDIN=
NEXT_PUBLIC_BRAND_SOCIAL_YOUTUBE=
NEXT_PUBLIC_BRAND_SOCIAL_FACEBOOK=

# --- Durable license store (REQUIRED on Vercel) ---
UPSTASH_REDIS_REST_URL=REPLACE_IF_AVAILABLE
UPSTASH_REDIS_REST_TOKEN=REPLACE_IF_AVAILABLE
LICENSE_STORE_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# --- Admin roster (REQUIRED) ---
PORTAL_SUPER_ADMIN_EMAILS=admin@thegoldmind.ai
PORTAL_ADMIN_EMAILS=admin@thegoldmind.ai
PORTAL_SUPPORT_EMAILS=support@thegoldmind.ai
PORTAL_AUDITOR_EMAILS=auditor@thegoldmind.ai
PORTAL_COMMERCIAL_MANAGER_EMAILS=
PORTAL_FINANCE_EMAILS=
PORTAL_QA_EMAILS=

# --- Email / Resend (REQUIRED for transactional mail) ---
RESEND_API_KEY=REPLACE_IF_AVAILABLE
# Must use @thegoldmind.ai (or NEXT_PUBLIC_BRAND_DOMAIN) — other domains are ignored by brand.resendFrom
RESEND_FROM_EMAIL=THE GOLD MIND PROFESSIONAL <noreply@thegoldmind.ai>
SUPPORT_EMAIL=support@thegoldmind.ai
SUPPORT_INBOX_EMAIL=support@thegoldmind.ai

# --- Payments / Paddle Live (REQUIRED for self-serve checkout) ---
PADDLE_VENDOR_ID=REPLACE_IF_AVAILABLE
PADDLE_PRICE_ID=REPLACE_IF_AVAILABLE
PADDLE_API_KEY=REPLACE_IF_AVAILABLE
PADDLE_WEBHOOK_SECRET=REPLACE_IF_AVAILABLE
# Do not set PAYMENT_FORCE_SANDBOX in production

# --- Google OAuth (OPTIONAL but recommended) ---
GOOGLE_CLIENT_ID=REPLACE_IF_AVAILABLE
GOOGLE_CLIENT_SECRET=REPLACE_IF_AVAILABLE
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# --- Hardening ---
# PORTAL_ALLOW_DEV_BYPASS=   # leave unset
# PORTAL_ALLOW_DEMO_SEED=    # leave unset
# PAYMENT_FORCE_SANDBOX=     # leave unset
